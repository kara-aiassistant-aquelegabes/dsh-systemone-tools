{
  "name": "@kara/dsh-systemone-tools",
  "version": "1.0.0",
  "description": "Decision gates for the DSH agent loop: a conclusion checker, a shell risk gate, an external-content injection filter, three model-callable tools, and a thresholds form on the Plugins page. Works with any decision endpoint or OpenAI-compatible API.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "lib/ask.js",
    "lib/exposed.js",
    "lib/guard.js",
    "lib/live.js",
    "lib/log.js",
    "lib/plain.js",
    "lib/policy.js",
    "lib/state.js",
    "lib/adapters/systemone.js",
    "lib/adapters/openai.js",
    "lib/tools/bash-risk.js",
    "lib/tools/conclusion.js",
    "lib/tools/injection.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/selftest.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "agent",
    "gates",
    "guardrails",
    "decision-model",
    "prompt-injection"
  ],
